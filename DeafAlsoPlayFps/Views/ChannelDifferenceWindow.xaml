<Window
    x:Class="DeafAlsoPlayFps.Views.ChannelDifferenceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="声道差值显示"
    Width="400"
    Height="176"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <!--  主容器  -->
        <Border
            x:Name="MainContainer"
            Width="380"
            Height="156"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#20000000"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="30">

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="88" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding DifferenceText}" />

                <!--  差值显示区域  -->
                <Grid Grid.Row="1">
                    <!--  背景轨道  -->
                    <Border
                        Height="24"
                        Background="#33FFFFFF"
                        CornerRadius="12" />

                    <!--  对准区：左右声道接近平衡时高亮，方便玩家确认朝向  -->
                    <Border
                        Width="44"
                        Height="22"
                        HorizontalAlignment="Center"
                        Background="#CCFFD84A"
                        CornerRadius="11"
                        Opacity="{Binding CenterAlignmentOpacity}" />

                    <!--  中心线  -->
                    <Rectangle
                        Width="1"
                        Height="24"
                        HorizontalAlignment="Center"
                        Fill="#AAFFFFFF" />

                    <!--  差值指示器  -->
                    <Canvas x:Name="DifferenceCanvas">
                        <!--  左侧区域 (负差值)  -->
                        <!--  左侧区域 (负差值)  -->
                        <Rectangle
                            x:Name="LeftDifferenceBar"
                            Canvas.Left="{Binding LeftBarPosition}"
                            Canvas.Top="2"
                            Width="{Binding LeftBarWidth}"
                            Height="20"
                            Fill="#FF4444"
                            RadiusX="8"
                            RadiusY="8" />

                        <!--  右侧区域 (正差值)  -->
                        <Rectangle
                            x:Name="RightDifferenceBar"
                            Canvas.Left="179"
                            Canvas.Top="2"
                            Width="{Binding RightBarWidth}"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Fill="#44FF44"
                            RadiusX="8"
                            RadiusY="8" />

                        <!--  中心点  -->
                        <Ellipse
                            x:Name="CenterPoint"
                            Canvas.Left="176"
                            Canvas.Top="9"
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Fill="White"
                            Visibility="Collapsed" />
                    </Canvas>

                    <!--  刻度标记  -->
                    <Canvas>
                        <!--  左侧刻度  -->
                        <Rectangle
                            Canvas.Left="95"
                            Canvas.Top="6"
                            Width="1"
                            Height="8"
                            Fill="#66FFFFFF" />
                        <Rectangle
                            Canvas.Left="47"
                            Canvas.Top="6"
                            Width="1"
                            Height="8"
                            Fill="#66FFFFFF" />

                        <!--  右侧刻度  -->
                        <Rectangle
                            Canvas.Left="285"
                            Canvas.Top="6"
                            Width="1"
                            Height="8"
                            Fill="#66FFFFFF" />
                        <Rectangle
                            Canvas.Left="333"
                            Canvas.Top="6"
                            Width="1"
                            Height="8"
                            Fill="#66FFFFFF" />
                    </Canvas>

                    <!--  标签  -->
                    <Grid Margin="5,0" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Left"
                            FontSize="8"
                            Foreground="#FF4444"
                            Text="L" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="8"
                            Foreground="#44FF44"
                            Text="R" />
                    </Grid>
                </Grid>

                <!--  时钟式八方向圆环：默认灰色，触发方向用半透明黄色高亮  -->
                <Grid
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding DirectionRingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Viewbox Width="82" Height="82">
                        <Grid Width="100" Height="100">
                            <Grid.Resources>
                                <Style x:Key="BaseSectorStyle" TargetType="Path">
                                    <Setter Property="Fill" Value="#667A7A7A" />
                                    <Setter Property="Stroke" Value="#33000000" />
                                    <Setter Property="StrokeThickness" Value="1.2" />
                                </Style>
                                <Style x:Key="ActiveSectorStyle" TargetType="Path">
                                    <Setter Property="Fill" Value="#CCFFD84A" />
                                    <Setter Property="Stroke" Value="#88FFF2A0" />
                                    <Setter Property="StrokeThickness" Value="1.4" />
                                </Style>
                            </Grid.Resources>

                            <Path Data="M 31.63,5.65 A 48,48 0 0 1 68.37,5.65 L 59.57,26.9 A 25,25 0 0 0 40.43,26.9 Z" Style="{StaticResource BaseSectorStyle}" />
                            <Path Data="M 68.37,5.65 A 48,48 0 0 1 94.35,31.63 L 73.1,40.43 A 25,25 0 0 0 59.57,26.9 Z" Style="{StaticResource BaseSectorStyle}" />
                            <Path Data="M 94.35,31.63 A 48,48 0 0 1 94.35,68.37 L 73.1,59.57 A 25,25 0 0 0 73.1,40.43 Z" Style="{StaticResource BaseSectorStyle}" />
                            <Path Data="M 94.35,68.37 A 48,48 0 0 1 68.37,94.35 L 59.57,73.1 A 25,25 0 0 0 73.1,59.57 Z" Style="{StaticResource BaseSectorStyle}" />
                            <Path Data="M 68.37,94.35 A 48,48 0 0 1 31.63,94.35 L 40.43,73.1 A 25,25 0 0 0 59.57,73.1 Z" Style="{StaticResource BaseSectorStyle}" />
                            <Path Data="M 31.63,94.35 A 48,48 0 0 1 5.65,68.37 L 26.9,59.57 A 25,25 0 0 0 40.43,73.1 Z" Style="{StaticResource BaseSectorStyle}" />
                            <Path Data="M 5.65,68.37 A 48,48 0 0 1 5.65,31.63 L 26.9,40.43 A 25,25 0 0 0 26.9,59.57 Z" Style="{StaticResource BaseSectorStyle}" />
                            <Path Data="M 5.65,31.63 A 48,48 0 0 1 31.63,5.65 L 40.43,26.9 A 25,25 0 0 0 26.9,40.43 Z" Style="{StaticResource BaseSectorStyle}" />

                            <Path Data="M 31.63,5.65 A 48,48 0 0 1 68.37,5.65 L 59.57,26.9 A 25,25 0 0 0 40.43,26.9 Z" Opacity="{Binding FrontDirectionOpacity}" Style="{StaticResource ActiveSectorStyle}" />
                            <Path Data="M 68.37,5.65 A 48,48 0 0 1 94.35,31.63 L 73.1,40.43 A 25,25 0 0 0 59.57,26.9 Z" Opacity="{Binding RightUpDirectionOpacity}" Style="{StaticResource ActiveSectorStyle}" />
                            <Path Data="M 94.35,31.63 A 48,48 0 0 1 94.35,68.37 L 73.1,59.57 A 25,25 0 0 0 73.1,40.43 Z" Opacity="{Binding RightDirectionOpacity}" Style="{StaticResource ActiveSectorStyle}" />
                            <Path Data="M 94.35,68.37 A 48,48 0 0 1 68.37,94.35 L 59.57,73.1 A 25,25 0 0 0 73.1,59.57 Z" Opacity="{Binding RightDownDirectionOpacity}" Style="{StaticResource ActiveSectorStyle}" />
                            <Path Data="M 68.37,94.35 A 48,48 0 0 1 31.63,94.35 L 40.43,73.1 A 25,25 0 0 0 59.57,73.1 Z" Opacity="{Binding BackDirectionOpacity}" Style="{StaticResource ActiveSectorStyle}" />
                            <Path Data="M 31.63,94.35 A 48,48 0 0 1 5.65,68.37 L 26.9,59.57 A 25,25 0 0 0 40.43,73.1 Z" Opacity="{Binding LeftDownDirectionOpacity}" Style="{StaticResource ActiveSectorStyle}" />
                            <Path Data="M 5.65,68.37 A 48,48 0 0 1 5.65,31.63 L 26.9,40.43 A 25,25 0 0 0 26.9,59.57 Z" Opacity="{Binding LeftDirectionOpacity}" Style="{StaticResource ActiveSectorStyle}" />
                            <Path Data="M 5.65,31.63 A 48,48 0 0 1 31.63,5.65 L 40.43,26.9 A 25,25 0 0 0 26.9,40.43 Z" Opacity="{Binding LeftUpDirectionOpacity}" Style="{StaticResource ActiveSectorStyle}" />
                        </Grid>
                    </Viewbox>

                    <TextBlock
                        Width="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="#E6FFFFFF"
                        Text="{Binding DirectionText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
